{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // config:recommended is not extended: its presets address ecosystems this
  // repo does not have.
  "extends": ["docker:pinDigests"],

  "dependencyDashboard": true,

  // Commit subjects here are plain imperative sentences.
  "semanticCommits": "disabled",

  // No `schedule` here: renovate.yml's cron owns when this runs.
  "prConcurrentLimit": 5,

  // A weekly run under the default hourly cap leaves every update past the
  // second for next week; prConcurrentLimit already bounds the CI load.
  "prHourlyLimit": 0,

  // It names the :local test image it builds, which no registry holds.
  "ignorePaths": ["docker-compose.yaml"],

  "customManagers": [
    {
      // The ci-tools lint toolchain, which the Makefile alone names.
      "customType": "regex",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": [
        "CI_TOOLS_IMAGE \\?= (?<depName>\\S+):(?<currentValue>[^:@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      // The test image's Pandoc: a release tarball, pinned per architecture
      // by its digest.
      "customType": "regex",
      "managerFilePatterns": ["/^tools/Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG \\w+=(?<currentValue>[^@\\s]+)@sha256:(?<currentDigest>[0-9a-f]{64})"
      ]
    }
  ],

  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "labels": ["dependencies", "github-actions"]
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "actions (minor and patch)"
    },
    {
      "matchDatasources": ["github-runners"],
      "labels": ["dependencies", "github-actions"]
    },
    {
      "matchDatasources": ["docker"],
      "labels": ["dependencies", "docker"]
    },

    // The oracle's reader. Pandoc tags a patch release with a fourth part
    // (3.9.0.2), which the default versioning drops. No group: the port's
    // review rides on its PR, which stays red until that lands.
    {
      "matchPackageNames": ["jgm/pandoc"],
      "versioning": "loose",
      "labels": ["dependencies", "pandoc"],
      "prBodyNotes": [
        "The port follows the Pandoc it was reviewed on: run [Bumping Pandoc](https://github.com/knight-owl-dev/prettier-plugin-pandoc/blob/main/docs/bumping-pandoc.md) on this branch."
      ]
    },

    {
      "matchManagers": ["npm"],
      "labels": ["dependencies", "npm"]
    },

    // The peer range is the support promise, and the suite tests only the
    // pinned devDependency. It moves by hand, with a devDependency major.
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    }
  ]
}
